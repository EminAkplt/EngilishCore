@*
    Admin - Cümle silme onay sayfası
*@
@model EnglishCore.Models.Sentence

@{
    ViewData["Title"] = "Cümle Sil";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0 text-danger"><i class="bi bi-trash me-2"></i>Cümle Sil</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="card border-0 shadow-sm border-danger">
    <div class="card-body p-4">
        <div class="alert alert-warning d-flex align-items-center mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <div>Bu cümleyi silmek üzeresin. Bu işlem geri alınamaz.</div>
        </div>

        @*  Silinecek cümlenin detayları  *@
        <dl class="row mb-4">
            <dt class="col-sm-3">Seviye</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">@Model.Level</span></dd>

            <dt class="col-sm-3">İngilizce</dt>
            <dd class="col-sm-9 fw-medium">@Model.EnglishText</dd>

            <dt class="col-sm-3">Türkçe</dt>
            <dd class="col-sm-9 text-muted">@Model.TurkishText</dd>
        </dl>

        <form asp-action="Delete" method="post" class="d-inline">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Sil
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
    </div>
</div>
