@*
    Admin - Yeni kelime ekleme formu
*@
@model EnglishCore.Models.Word

@{
    ViewData["Title"] = "Yeni Kelime";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2"></i>Yeni Kelime</h2>
    @*  Listeye dönüş butonu  *@
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Geri
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post" novalidate>
            @*  İngilizce kelime alanı  *@
            <div class="mb-3">
                <label asp-for="EnglishText" class="form-label fw-medium">İngilizce</label>
                <input asp-for="EnglishText" class="form-control" placeholder="apple" />
                <span asp-validation-for="EnglishText" class="text-danger small"></span>
            </div>

            @*  Türkçe karşılığı alanı  *@
            <div class="mb-3">
                <label asp-for="TurkishText" class="form-label fw-medium">Türkçe</label>
                <input asp-for="TurkishText" class="form-control" placeholder="elma" />
                <span asp-validation-for="TurkishText" class="text-danger small"></span>
            </div>

            @*  Seviye seçimi dropdown — A1-C2  *@
            <div class="mb-4">
                <label asp-for="Level" class="form-label fw-medium">Seviye</label>
                <select asp-for="Level" class="form-select">
                    <option value="">-- Seç --</option>
                    <option value="A1">A1 — Başlangıç</option>
                    <option value="A2">A2 — Temel</option>
                    <option value="B1">B1 — Orta</option>
                    <option value="B2">B2 — Orta-Üstü</option>
                    <option value="C1">C1 — İleri</option>
                    <option value="C2">C2 — Ustaca</option>
                </select>
                <span asp-validation-for="Level" class="text-danger small"></span>
            </div>

            @*  Form butonları  *@
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle me-1"></i>Kaydet
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
        </form>
    </div>
</div>

@section Scripts {
    @*  jQuery validation script'leri — client-side validation için  *@
    <partial name="_ValidationScriptsPartial" />
}
